# This file is a template; the application does not automatically load .env.
# The demo command reads this variable only when --output is absent.
CHENGKONG_RUN_DIR=/root/autodl-tmp/chengkong-data/runs

# Read only when config/multimodal.local.json explicitly enables structured_http.
# No other project or home directory is searched for credentials.
CHENGKONG_VLM_API_KEY=

# Learning data/model locations and seed are configured in
# configs/training-small.json, not inferred from environment variables.
# Web/CLI model loading is explicit: --model-dir /root/autodl-tmp/chengkong-models/round2
