# Suggested future data/model mappings; these directories are not auto-created.
CHENGKONG_DATA_DIR=/root/autodl-tmp/chengkong-data
CHENGKONG_MODEL_DIR=/root/autodl-tmp/chengkong-models
# Only this variable is consumed now, by `chengkong demo` when --output is absent.
# Export it explicitly; the application does not auto-load .env.
CHENGKONG_RUN_DIR=/root/autodl-tmp/chengkong-data/runs

# Reserved adapter configuration. VLM/LLM stays not_configured in v0.1.
CHENGKONG_VLM_PROVIDER=disabled
CHENGKONG_VLM_BASE_URL=
CHENGKONG_VLM_MODEL=
CHENGKONG_VLM_API_KEY=

# Reserved for subsequent learning work. Current algorithms use CPU, no randomness.
CHENGKONG_DEVICE=cpu
CHENGKONG_RANDOM_SEED=20261022
